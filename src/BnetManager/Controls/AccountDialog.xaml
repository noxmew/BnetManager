<ui:ModernWindow x:Class="BnetManager.Controls.AccountDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:BnetManager.Controls"
 Style="{StaticResource {x:Type ui:ModernWindow}}"
 Title="账号" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="32,24,32,32">
  <TextBlock x:Name="Description" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="15" LineHeight="26" Margin="0,0,0,28"/>
  <TextBlock Text="区服" Style="{StaticResource Label}"/>
  <Border x:Name="ReadOnlyRegion" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,14" MinHeight="52" HorizontalAlignment="Left" Margin="0,0,0,28">
   <TextBlock x:Name="RegionDisplay" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold"/>
  </Border>
  <ListBox x:Name="RegionPicker" SelectedValuePath="Region" Background="Transparent" BorderThickness="0" Padding="0" Margin="-4,0,-4,28" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
   <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
    <Setter Property="Margin" Value="4,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Tile" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,20" MinHeight="96"><ContentPresenter VerticalAlignment="Center"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource AccentSoft}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Ink}"/><TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel x:Name="Details">
   <TextBlock Text="账号备注" Style="{StaticResource Label}"/>
   <TextBox x:Name="NameInput" MaxLength="40" Margin="0,0,0,26"/>
   <TextBlock Text="战网昵称（可选）" Style="{StaticResource Label}"/>
   <TextBox x:Name="TagInput" MaxLength="80"/>
  </StackPanel>
  <TextBlock x:Name="Validation" Style="{StaticResource ValidationText}"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
   <Button Content="取消" IsCancel="True" MinWidth="108" Margin="0,0,12,0"/>
   <Button x:Name="AcceptButton" Content="保存账号" Style="{StaticResource Primary}" Click="AcceptClick" IsDefault="True" MinWidth="128"/>
  </StackPanel>
 </StackPanel>
</ui:ModernWindow>
