<ui:ModernWindow x:Class="BnetManager.Controls.SettingsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:BnetManager.Controls"
 Style="{StaticResource {x:Type ui:ModernWindow}}"
 Title="设置" Width="720" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="32,24,32,32">
  <TextBlock Text="战网启动程序" Style="{StaticResource Label}"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="LauncherInput"/>
   <Button Grid.Column="2" Content="浏览" Click="BrowseClick" Height="52" MinWidth="92"/>
  </Grid>
  <Button Content="打开数据目录" Click="OpenDataClick" HorizontalAlignment="Left" Margin="0,22,0,0" Background="Transparent" BorderBrush="Transparent" Padding="0" Foreground="{StaticResource Accent}"/>
  <TextBlock x:Name="Validation" Style="{StaticResource ValidationText}"/>
  <Border Height="1" Background="{StaticResource Line}" Margin="0,28,0,28"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="BnetManager" FontSize="16"/>
    <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
   </StackPanel>
   <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Click="CheckUpdateClick" MinWidth="128"/>
  </Grid>
  <Grid x:Name="UpdateResult" Visibility="Collapsed" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <Button x:Name="UpdateDownloadButton" Grid.Column="1" Content="前往下载" Click="DownloadUpdateClick" Visibility="Collapsed" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Accent}" Padding="0" Margin="20,0,0,0" Height="28"/>
  </Grid>
  <Grid Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Grid.Column="1" Content="取消" IsCancel="True" MinWidth="108"/>
   <Button Grid.Column="3" Content="保存设置" Style="{StaticResource Primary}" Click="SaveClick" IsDefault="True" MinWidth="128"/>
  </Grid>
 </StackPanel>
</ui:ModernWindow>
