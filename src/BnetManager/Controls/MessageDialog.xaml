<ui:ModernWindow x:Class="BnetManager.Controls.MessageDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:BnetManager.Controls"
 Style="{StaticResource {x:Type ui:ModernWindow}}"
 Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="32,24,32,32">
  <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="16" LineHeight="28"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
   <Button x:Name="CancelButton" IsCancel="True" Content="取消" MinWidth="108" Margin="0,0,12,0" Visibility="Collapsed"/>
   <Button x:Name="AcceptButton" Content="确定" Style="{StaticResource Primary}" Click="AcceptClick" IsDefault="True" MinWidth="112"/>
  </StackPanel>
 </StackPanel>
</ui:ModernWindow>
