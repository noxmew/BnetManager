<ui:ModernWindow x:Class="BnetManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:BnetManager.Controls"
 Style="{StaticResource {x:Type ui:ModernWindow}}"
 xmlns:core="clr-namespace:BnetManager.Core"
 Title="BnetManager" Width="1120" Height="720" MinWidth="900" MinHeight="560"
 WindowStartupLocation="CenterScreen" Icon="Assets/App.ico" Closing="WindowClosing">
 <ui:ModernWindow.Resources>
  <Style x:Key="AccountRow" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="24,22"/>
   <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F7FAFF"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F5FF"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ui:ModernWindow.Resources>
 <Grid Margin="36,28,36,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,28">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="账号" FontSize="32" FontWeight="SemiBold"/>
    <Border Background="#E9EEF7" CornerRadius="8" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
     <TextBlock x:Name="AccountCount" Foreground="{StaticResource Muted}" FontSize="14"/>
    </Border>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <StackPanel x:Name="LoginActions" Orientation="Horizontal">
     <Button x:Name="SaveCurrentButton" Click="SaveCurrentClick" AutomationProperties.Name="保存当前账号" Width="170" Margin="0,0,12,0">
      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource SaveIcon}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.2" Margin="0,0,10,0"/><TextBlock Text="保存当前账号" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="NewLoginButton" Click="NewLoginClick" AutomationProperties.Name="登录新账号" Width="152" Style="{StaticResource Primary}">
      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,10,0"/><TextBlock Text="登录新账号" VerticalAlignment="Center"/></StackPanel>
     </Button>
    </StackPanel>
    <Button x:Name="SettingsButton" AutomationProperties.Name="设置" ToolTip="设置" Style="{StaticResource IconButton}" Width="48" Height="48" Margin="16,0,0,0" Click="SettingsClick">
     <Path Data="{StaticResource SettingsIcon}" Width="22" Height="22" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
    </Button>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
   <Grid>
    <ListBox x:Name="AccountsList" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" Padding="0"
     ItemContainerStyle="{StaticResource AccountRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="AccountKeyDown">
     <ListBox.Template><ControlTemplate TargetType="ListBox">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Background="#F9FBFE" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0">
        <Grid Width="{Binding ActualWidth, ElementName=AccountItems}" HorizontalAlignment="Left">
         <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="188"/></Grid.ColumnDefinitions>
          <TextBlock Text="账号" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="区服" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="操作" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
         </Grid>
        </Grid>
       </Border>
       <ScrollViewer Grid.Row="1" Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsPresenter x:Name="AccountItems"/>
       </ScrollViewer>
      </Grid>
     </ControlTemplate></ListBox.Template>
     <ListBox.ItemTemplate><DataTemplate DataType="{x:Type core:AccountProfile}">
      <Grid MinHeight="76">
       <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="144"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
       <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E5EFFF"/><GradientStop Color="#EDF0FF" Offset="1"/></LinearGradientBrush></Border.Background>
        <TextBlock Text="{Binding Initial}" FontSize="26" FontWeight="SemiBold" Foreground="#3A5BBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding BattleTag}" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
         <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
          <DataTrigger Binding="{Binding BattleTag}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          <DataTrigger Binding="{Binding BattleTag}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </StackPanel>
       <Border Grid.Column="2" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="13,8" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="{Binding RegionName}" Foreground="{StaticResource AccentText}" FontSize="14"/>
       </Border>
       <Button Grid.Column="3" Style="{StaticResource Primary}" Click="SwitchClick" Width="128" Height="48" FontSize="16" Margin="0,0,16,0" AutomationProperties.Name="{Binding Name, StringFormat=启动或切换到 {0}}">
        <StackPanel Orientation="Horizontal">
         <Path Data="M2,1 L10,6 L2,11 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="14" Stretch="Uniform" Margin="0,0,10,0"/>
         <TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="启动"/><Style.Triggers><DataTrigger Binding="{Binding IsClientRunning, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Text" Value="切换"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
       </Button>
       <Button Grid.Column="4" Style="{StaticResource IconButton}" Click="AccountMenuClick" ToolTip="账号操作" AutomationProperties.Name="{Binding Name, StringFormat={}{0}的操作}">
        <Path Data="{StaticResource MoreIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform"/>
        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
         <MenuItem Header="更新登录状态" Click="RefreshSessionClick"><MenuItem.Icon><Path Data="{StaticResource RefreshIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3"/></MenuItem.Icon></MenuItem>
         <MenuItem Header="编辑账号" Click="EditClick"><MenuItem.Icon><Path Data="{StaticResource EditIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3"/></MenuItem.Icon></MenuItem>
         <Separator Style="{StaticResource MenuSeparator}"/>
         <MenuItem Header="移除账号" Click="DeleteClick" Foreground="{StaticResource DangerInk}"><MenuItem.Icon><Path Data="{StaticResource DeleteIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource DangerInk}" StrokeThickness="1.3"/></MenuItem.Icon></MenuItem>
        </ContextMenu></Button.ContextMenu>
       </Button>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel x:Name="EmptyState" Margin="0,56,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
     <TextBlock Text="暂无账号" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="18"/>
     <Button Content="保存当前账号" Click="SaveCurrentClick" Width="176" Margin="0,24,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Height="3" Margin="0,18,0,0">
   <ProgressBar x:Name="OperationProgress" IsIndeterminate="True" Visibility="Collapsed"/>
  </Grid>
  <Grid Grid.Row="3" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,1,24,0">
    <Ellipse x:Name="ClientDot" Width="7" Height="7" Fill="#78859A" Margin="0,0,9,0"/>
    <TextBlock x:Name="ClientState" Text="战网未运行" Foreground="{StaticResource Muted}" FontSize="13"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Right"/>
  </Grid>
 </Grid>
</ui:ModernWindow>
